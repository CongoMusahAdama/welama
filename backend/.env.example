PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First admin (only used if no admin exists yet)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# mNotify
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Welama

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Storefront URL (comma-separated if you have more than one)
CLIENT_URL=https://welama-gh.shop
FRONTEND_URL=https://welama-gh.shop
